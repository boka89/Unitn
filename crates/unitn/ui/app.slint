// Unitn main window.

import { Palette, ListView, Spinner } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    AlbumItem, TrackItem, ArtistItem, StationItem, QueueEntry, PlaylistItem, MenuRow, FixCandidate, ServerItem, Chip,
    PodcastItem, EpisodeItem,
    IconButton, PillButton, NavItem, Dnd, DropTarget, SeekBar, SearchBox, Artwork, Spectrum, Visualizer, VizInfo, TextField, VizControls, BrandMark, IdleArea, SearchHit } from "widgets.slint";
import { AlbumsPage, AlbumDetailPage, ArtistsPage, SongsPage, RadioPage, QueuePage, NowPlayingPage, SettingsPage, PlaylistPage, ServerPage, PodcastsPage, StatisticsPage, StatTile, StatRow, DayBar } from "pages.slint";

export { StatTile, StatRow, DayBar, SearchHit }
export { Theme, Dnd, VizInfo, AlbumItem, TrackItem, ArtistItem, StationItem, QueueEntry, PlaylistItem, FixCandidate, ServerItem, PodcastItem, EpisodeItem }

component ThemeSwitch inherits Rectangle {
    callback selected(int);
    height: 36px;
    border-radius: 18px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in [
            { icon: @image-url("icons/monitor.svg"), mode: 0 },
            { icon: @image-url("icons/sun.svg"), mode: 1 },
            { icon: @image-url("icons/moon.svg"), mode: 2 },
        ]: Rectangle {
            horizontal-stretch: 1;
            border-radius: 15px;
            background: Theme.mode == option.mode ? Theme.accent : (touch.has-hover ? Theme.surface-hover : transparent);
            animate background { duration: 150ms; }
            Image {
                source: option.icon;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Theme.mode == option.mode ? Theme.on-accent : Theme.fg-muted;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(option.mode); }
            }
        }
    }
}

/// The startup animation (see src/intro.rs) in its own small window, so it
/// always has the same size, whatever size the main window was left at.
export component SplashWindow inherits Window {
    in property <image> frame;
    in property <bool> fading: false;
    callback skip();
    callback finished();
    title: "Unitn";
    no-frame: true;
    width: 880px;
    height: 495px;
    background: #0C091E;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: cover;
        opacity: root.fading ? 0 : 1;
        animate opacity { duration: 350ms; easing: ease-in; }
    }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            root.skip();
            accept
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.skip(); }
    }
}

export component AppWindow inherits Window {
    title: "Unitn player";
    icon: @image-url("../icons/256x256.png");
    min-width: root.mini-player ? 340px : 960px;
    min-height: root.mini-player ? 132px + (root.mini-lyrics ? 34px : 0px) + root.titlebar-inset : 620px;
    always-on-top: root.mini-player && root.mini-on-top;
    preferred-width: 1280px;
    preferred-height: 820px;
    background: root.viz-fullscreen ? (Theme.dark ? #050508 : Theme.bg) : Theme.bg.transparentize(Theme.see-through);
    full-screen: root.viz-fullscreen;
    default-font-size: 13px;

    /// Space for the macOS window buttons (the title bar is drawn by us there).
    in property <length> titlebar-inset: 0px;

    /// Phone-sized window: no sidebar; four tabs sit at the bottom (Music,
    /// Radio, Podcasts, Settings) and the player bar is compact.
    /// Page 11 is the phone's list of playlists, page 12 its Sources
    /// (music folders and servers).
    property <bool> phone: root.width < 720px || root.height < 520px;
    changed phone => {
        Theme.phone = root.phone;
        if (!root.phone && (root.page == 11 || root.page == 12)) { root.page = 0; }
    }
    /// The Android app on a phone (the desktop starts on Albums as before).
    property <bool> mobile-phone: Theme.mobile && root.phone;
    changed mobile-phone => { root.start-on-phone(); }
    /// A phone starts on Music in its Song view (once).
    function start-on-phone() {
        if (root.mobile-phone && !root.phone-started) {
            root.phone-started = true;
            if (root.page == 0 && !root.albums-filtered) { root.page = 2; }
        }
    }
    property <bool> phone-started: false;
    changed page => {
        root.page-changed(root.page);
        if (root.page != 0 && root.page != 1 && root.page != 2 && root.page != 3 && root.page != 9 && root.page != 10) {
            root.search-open = false;
        }
        if (root.page != 4 && root.page != 11 && root.page != 8) { root.music-group = false; }
        if (root.page == 0 || root.page == 1 || root.page == 2 || (root.music-group && (root.page == 4 || root.page == 11))) { root.music-page = root.page; }
        if (root.page != 11 && root.page != 8) { root.np-group = false; }
        if (root.page != 6) {
            root.before-player = root.page;
            root.before-player-music = root.music-group;
        }
    }
    /// Phone: the Queue or the playlists were opened from Music's chips, so
    /// they show the Music chips.
    property <bool> music-group: false;
    /// Phone: the page shown before Now Playing (a swipe down goes back to it).
    property <int> before-player: 2;
    property <bool> before-player-music: false;
    /// Phone: the search box is shown instead of the page title.
    property <bool> search-open: false;
    /// Phone: the Music view last shown (0 albums, 1 artists, 2 songs);
    /// the Music tab opens it again.
    property <int> music-page: 2;
    /// Phone: the playlists (page 11) were opened from Now Playing's
    /// "Playlists" chip, so they show the Now Playing chips.
    property <bool> np-group: false;
    /// Phone: Music's Song, Album, Artist, Playlist and Queue views, with their
    /// chips (at the bottom, above the player bar).
    property <bool> music-chips: root.phone && (root.page == 0 || root.page == 1 || root.page == 2 || (root.music-group && (root.page == 4 || root.page == 11 || root.page == 8)));
    /// Phone: Now Playing, Queue, Playlists (also from the Playlists tab) or
    /// Sources, with the Player / Queue / Playlists / Sources chips.
    property <bool> np-chips: root.phone && !root.music-chips && (root.page == 6 || root.page == 4 || root.page == 12 || root.page == 11 || root.page == 8);
    /// Phone: a server's albums (page 9) were opened from Sources, not Settings.
    property <bool> server-from-sources: false;
    /// Phone: which bottom tab is lit (-1: none).
    property <int> active-tab: root.music-chips || (root.page == 5 && !root.album-from-server-page) ? 0
        : root.page == 3 ? 1
        : root.page == 10 ? 2
        : root.np-chips || root.page == 6 ? -1
        : 3;
    /// Mini player: the window shrinks to a small player (cover, song,
    /// controls, volume) that stays on top of other windows.
    in property <bool> mini-player: false;
    in-out property <bool> mini-on-top: true;
    callback toggle-mini-player();
    /// The mini player shows the line of the lyrics being sung.
    in property <bool> mini-lyrics: false;
    callback toggle-mini-lyrics();

    // Pages: 0 albums, 1 artists, 2 songs, 3 radio, 4 queue, 5 album detail, 6 now playing, 7 settings, 8 playlist
    in-out property <int> page: 0;

    // Library
    in property <[AlbumItem]> albums;
    in property <string> albums-title: "Albums";

    /// Sorting of the Albums (0), Artists (1) and Songs (2) pages: the menu
    /// labels, the chosen order and whether it currently runs high-to-low.
    in property <[string]> album-sort-labels;
    in property <[string]> artist-sort-labels;
    in property <[string]> song-sort-labels;
    in property <int> album-sort;
    in property <int> artist-sort;
    in property <int> song-sort;
    in property <bool> album-sort-desc;
    in property <bool> artist-sort-desc;
    in property <bool> song-sort-desc;
    /// Choose an order on a page (page, order index).
    callback set-sort(int, int);
    /// Flip the direction of the page's order.
    callback flip-sort(int);
    property <[string]> sort-labels: root.page == 0 ? root.album-sort-labels
        : root.page == 1 ? root.artist-sort-labels : root.song-sort-labels;
    property <int> sort-index: root.page == 0 ? root.album-sort
        : root.page == 1 ? root.artist-sort : root.song-sort;
    property <bool> sort-desc: root.page == 0 ? root.album-sort-desc
        : root.page == 1 ? root.artist-sort-desc : root.song-sort-desc;
    in property <bool> albums-filtered: false;
    // The artist page (Albums filtered to one artist): its header.
    in property <string> artist-name;
    in property <string> artist-info;
    in property <image> artist-image;
    in property <bool> artist-has-image;
    callback play-artist(bool);
    /// Back from an artist's page: to the Artists grid.
    function artist-back() {
        root.show-all-albums();
        root.page = 1;
    }
    in property <AlbumItem> album;
    /// Key of the album the playing song belongs to ("" for none).
    in property <string> playing-album;
    in property <string> album-info;
    in property <string> album-genre;
    in property <[TrackItem]> album-tracks;
    in property <[ArtistItem]> artists;
    in property <[TrackItem]> songs;
    in property <bool> library-empty: true;
    in property <bool> scanning: false;
    in property <string> library-status;
    in property <string> library-query;

    // Radio
    in property <[StationItem]> stations;

    // Statistics page (page 11).
    in property <int> stats-period: 0;
    in property <[StatTile]> stats-tiles;
    in property <[StatTile]> stats-library;
    in property <[DayBar]> stats-days;
    in property <string> stats-days-total;
    in property <[StatRow]> stats-songs;
    in property <[StatRow]> stats-artists;
    in property <[StatRow]> stats-albums;
    in property <[StatRow]> stats-genres;
    in property <bool> stats-empty: true;
    callback stats-period-changed(int);
    in property <int> radio-tab: 0;
    /// Radio browsing: the Country, Language, Tag, Format and Bitrate
    /// buttons and the list of the one that's open.
    in property <[string]> radio-filter-labels: ["Country", "Language", "Tag", "Format", "Bitrate"];
    in property <[bool]> radio-filter-active: [false, false, false, false, false];
    in property <string> radio-picker-title;
    in property <[string]> radio-picker-items;
    in property <bool> radio-picker-loading;
    in-out property <string> radio-picker-query;
    callback radio-open-picker(int);
    callback radio-picker-search(string);
    callback radio-picker-pick(int);
    in property <bool> radio-filtered: false;
    in property <[bool]> radio-genres: [false, false, false, false, false, false];
    in property <bool> radio-loading: false;
    in property <string> radio-status;

    // Queue & now playing
    in property <[QueueEntry]> queue;
    in property <string> current-key;
    in property <bool> has-track: false;
    in property <bool> is-radio: false;
    in property <string> np-title: "Not playing";
    in property <string> np-subtitle;
    in property <image> np-cover;
    in property <bool> np-has-cover: false;
    in property <image> np-backdrop;
    in property <bool> np-has-backdrop: false;
    /// The playing song can be liked (not radio or podcasts), and is.
    in property <bool> np-can-like: false;
    in property <bool> np-liked: false;
    callback toggle-like();
    in property <bool> playing: false;
    in property <bool> buffering: false;
    in property <float> position: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> seekable: false;
    in-out property <float> volume: 0.8;
    in property <bool> shuffle: false;
    in property <int> repeat-mode: 0;
    in property <string> toast;
    /// Files are being dragged over the window.
    in property <bool> drop-hover: false;

    // Visualizer (FFT bars 0..1)
    in property <[float]> viz-bars;
    in property <[float]> viz-peaks;
    in property <[float]> mini-bars;
    in property <[float]> mini-peaks;
    /// 0 Spectrum, 1 Mirror, 2 Wave, 3 Oscilloscope, 4 Radial
    in-out property <int> viz-style: 0;
    in-out property <bool> viz-fullscreen: false;
    in property <string> viz-path-a: "M 0 1000 L 1000 1000";
    in property <string> viz-path-b: "M 0 1000 L 1000 1000";
    callback viz-style-changed(int);

    // Playlists
    in property <[PlaylistItem]> playlists;
    in property <int> current-playlist: -1;
    in property <string> playlist-name;
    in property <string> playlist-info;
    in property <[TrackItem]> playlist-tracks;
    callback open-playlist(int);
    callback new-playlist();
    callback import-playlist();
    callback rename-playlist(string);
    callback delete-playlist();
    callback export-playlist();
    callback play-playlist(bool);
    callback play-playlist-track(int);
    callback save-queue-as-playlist();
    // Song menu: context 0 album track, 1 song, 2 playlist track, 3 whole album
    property <int> menu-context: 0;
    property <length> menu-x;
    property <length> menu-y;
    // Music servers
    in property <[ServerItem]> servers;
    in property <int> current-server: -1;
    in property <string> server-name;
    in property <[AlbumItem]> server-albums;
    in property <string> server-status;
    in property <bool> server-loading;
    in property <bool> album-from-server: false;
    /// The server album was opened from the library's Albums, not from a
    /// server's own albums page (Back returns to Albums).
    in property <bool> album-in-library: false;
    property <bool> album-from-server-page: root.album-from-server && !root.album-in-library;
    /// Source chips of the Music views: All, Phone, then each server.
    in property <[string]> source-names;
    in property <int> source-selected: 0;
    /// Name of the server chosen with the source chips ("" = none).
    in property <string> source-server-name;
    callback select-source(int);
    callback albums-visible(int, int);
    callback server-albums-visible(int, int);
    in-out property <bool> server-dialog: false;
    in-out property <int> server-kind: 0;
    in property <string> server-dialog-status;
    in property <bool> server-connecting: false;
    callback open-server(int);
    callback refresh-server();
    callback open-server-album(int);
    callback connect-server(int, string, string, string);
    callback close-server-dialog();
    // Plex servers found on the network (GDM), as "Name · ip:port".
    in property <bool> plex-searching: false;
    in property <[string]> plex-found;
    in-out property <string> server-url-text;
    callback find-plex();
    callback pick-plex(int);
    property <string> server-user-text;
    property <string> server-secret-text;
    callback remove-server(int);
    // "Fix album info" dialog
    in-out property <bool> fix-visible: false;
    in-out property <string> fix-artist;
    in-out property <string> fix-album;
    in property <[FixCandidate]> fix-candidates;
    in property <int> fix-selected: -1;
    in property <string> fix-status;
    in property <bool> fix-busy: false;
    in property <image> fix-preview;
    in property <bool> fix-has-preview: false;
    callback fix-search(string, string);
    callback fix-select(int);
    callback fix-choose-image();
    callback fix-save(string, string);
    callback fix-cancel();
    callback track-menu-requested(int, int);
    callback track-menu-action(int, int);
    // Songs page: picked songs and swipes.
    in property <int> song-selection-count: 0;
    callback toggle-song-selected(int);
    callback clear-song-selection();
    callback song-swiped(int, bool) -> string;
    /// Reorder a song in the open playlist (from index, to index).
    callback move-playlist-track(int, int);

    // Settings
    in property <[string]> folders;
    in property <string> app-version;
    in property <string> log-path;
    in-out property <bool> download-art: true;
    callback download-art-changed(bool);
    /// Sorting skips a leading "The", "A" or "An".
    in-out property <bool> sort-ignore-articles: true;
    callback sort-ignore-articles-changed(bool);
    /// The page changed (the Artists page loads its pictures while shown).
    callback page-changed(int);
    /// Albums / artists on screen in their grids (first and last index):
    /// only their pictures are kept in memory.
    callback album-range(int, int);
    callback artist-range(int, int);

    // Navigation & library
    callback open-album(int);
    callback open-artist(int);
    callback show-all-albums();
    callback play-album(bool);
    callback play-album-track(int);
    callback play-song(int);
    callback library-search(string);
    /// Desktop: suggestions under the search box while typing.
    in property <[SearchHit]> search-hits;
    property <bool> search-dropdown: false;
    callback search-pick(int, int);
    callback add-folder();
    callback rescan();
    // Radio
    callback radio-select-tab(int);
    callback radio-search(string);
    // Podcasts (page 10)
    callback podcast-search(string);
    callback podcast-subscribe(int);
    callback podcast-open(int);
    callback podcast-back();
    callback podcast-refresh();
    callback podcast-unsubscribe();
    callback podcast-play(int);
    callback podcast-toggle-favorite(int);
    callback podcast-toggle-show-favorite();
    in property <bool> podcast-favorite;
    in property <int> podcast-view: 0;
    in property <bool> podcast-searching;
    in property <[PodcastItem]> podcast-results;
    in property <[PodcastItem]> podcast-shows;
    in property <bool> podcast-loading;
    in property <string> podcast-status;
    in property <string> podcast-title;
    in property <string> podcast-author;
    in property <string> podcast-description;
    in property <image> podcast-image;
    in property <bool> podcast-has-image;
    in property <[EpisodeItem]> podcast-episodes;
    // Lyrics (Now Playing)
    in property <bool> lyrics-open: false;
    in property <[string]> lyrics-lines;
    in property <int> lyrics-current: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-status;
    in property <string> lyrics-source;
    /// Online lyrics of a song on this computer: they can be saved with it.
    in property <bool> lyrics-can-save;
    /// Save the shown lyrics: 0 as a file next to the song, 1 in its tags.
    callback save-lyrics(int);
    in property <int> lyrics-autosave;
    callback lyrics-autosave-changed(int);
    callback lyrics-open-changed(bool);
    // Playback settings
    in property <int> crossfade: 0;
    callback crossfade-changed(int);
    in property <bool> gapless-albums: false;
    callback gapless-albums-changed(bool);
    in property <bool> lyrics-online: true;
    callback lyrics-online-changed(bool);
    in property <bool> startup-sound: true;
    callback startup-sound-changed(bool);
    // Startup animation (see src/intro.rs).
    in property <bool> intro-visible: false;
    in property <bool> intro-fading: false;
    in property <image> intro-frame;
    callback intro-skip();
    in property <bool> resume-session: true;
    callback resume-session-changed(bool);
    callback radio-genre(int);
    callback add-custom-stream(string, string);
    callback play-station(int);
    callback toggle-favorite(int);
    // Queue
    callback play-queue-index(int);
    callback remove-queue-index(int);
    callback clear-queue();
    callback move-queue-index(int, int);
    // Transport
    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-relative(float);
    callback volume-changed(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback theme-selected(int);
    callback density-changed(bool);
    in property <bool> eq-open: false;
    in property <bool> eq-enabled: false;
    in property <[float]> eq-gains;
    in property <float> eq-preamp: 0;
    in property <int> eq-preset: 0;
    in property <string> eq-curve;
    callback eq-open-changed(bool);
    callback eq-toggle(bool);
    callback eq-preset-selected(int);
    callback eq-band-changed(int, float);
    callback eq-preamp-changed(float);
    callback eq-reset();
    callback eq-curve-aspect(float);
    callback opacity-changed(float);
    in property <bool> glass-available: false;
    in property <bool> glass: false;
    callback glass-changed(bool);
    in property <int> glass-countdown: 0;
    callback glass-keep();
    callback remove-folder(int);

    /// Volume to bring back when unmuting.
    property <float> volume-before-mute: 0.8;
    function set-volume(v: float) {
        root.volume = Math.max(0.0, Math.min(1.0, v));
        root.volume-changed(root.volume);
    }
    function toggle-mute() {
        if (root.volume > 0.001) {
            root.volume-before-mute = root.volume;
            root.set-volume(0.0);
        } else {
            root.set-volume(root.volume-before-mute > 0.001 ? root.volume-before-mute : 0.8);
        }
    }

    function show-track-menu(context: int, index: int, x: length, y: length) {
        root.menu-context = context;
        root.menu-x = x;
        root.menu-y = y;
        root.track-menu-requested(context, index);
        track-menu.show();
    }

    /// Android's Back button: one step back inside the app. False when
    /// there is nowhere to go back to (the app then goes to the background).
    public function go-back() -> bool {
        track-menu.close();
        add-stream-popup.close();
        if (root.viz-fullscreen) {
            root.viz-fullscreen = false;
            keys.focus();
            return true;
        }
        if (root.server-dialog) { root.close-server-dialog(); return true; }
        if (root.fix-visible) { root.fix-cancel(); return true; }
        if (root.page == 2 && root.song-selection-count > 0) { root.clear-song-selection(); return true; }
        if (root.search-open) { root.search-open = false; keys.focus(); return true; }
        if (root.page == 5) { root.page = root.album-from-server-page ? 9 : 0; return true; }
        if (root.page == 10 && root.podcast-view == 1) { root.podcast-back(); return true; }
        if (root.page == 0 && root.albums-filtered) { root.artist-back(); return true; }
        if (!root.phone) {
            if (root.page == 0) { return false; }
            root.page = 0;
            return true;
        }
        // Phone: Music is the first screen; Queue and the Now Playing
        // playlists go back to the player, a playlist to the playlists,
        // a server to Settings, everything else to Music.
        if (root.music-chips && root.page != 8) { return false; }
        if (root.page == 13) {
            root.page = 7;
        } else if (root.page == 4 || (root.page == 11 && root.np-group)) {
            root.page = 6;
        } else if (root.page == 8) {
            root.page = 11;
        } else if (root.page == 9) {
            root.page = root.server-from-sources ? 12 : 7;
        } else if (root.page == 12) {
            root.page = 6;
        } else {
            root.page = root.music-page;
        }
        return true;
    }

    /// Next/previous visualizer style.
    public function step-viz(delta: int) {
        root.viz-style = Math.mod(root.viz-style + delta + 5, 5);
        root.viz-style-changed(root.viz-style);
    }

    /// Applies a theme mode (0 system, 1 light, 2 dark) to our colors and the std widgets.
    public function apply-theme(mode: int) {
        Theme.mode = mode;
        if (mode == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (mode == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = Theme.system-dark ? ColorScheme.dark : ColorScheme.light;
        }
    }

    init => {
        Theme.system-dark = Palette.color-scheme != ColorScheme.light;
        Theme.phone = root.phone;
        root.start-on-phone();
    }

    // Keyboard shortcuts (keys typed into text fields are handled there first).
    keys := FocusScope {
        // Keep clear of the system bars on phones and tablets (status bar,
        // navigation bar, notch). The insets are zero on the desktop.
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        init => { self.focus(); }
        key-pressed(event) => {
            if (root.intro-visible) { root.intro-skip(); return accept; }
            if (event.text == Key.Back) {
                return root.go-back() ? accept : reject;
            }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.RightArrow) { root.next(); return accept; }
                if (event.text == Key.LeftArrow) { root.previous(); return accept; }
                if (event.text == "f" || event.text == "F") { if (!root.mini-player) { search.focus-input(); } return accept; }
                if (event.modifiers.shift && (event.text == "m" || event.text == "M")) { root.toggle-mini-player(); return accept; }
                return reject;
            }
            if (event.text == Key.Escape && root.page == 2 && root.song-selection-count > 0) { root.clear-song-selection(); return accept; }
            if (event.text == " ") { root.toggle-play(); return accept; }
            if (event.text == Key.RightArrow) { root.seek-relative(5); return accept; }
            if (event.text == Key.LeftArrow) { root.seek-relative(-5); return accept; }
            if (event.text == Key.UpArrow) { root.set-volume(root.volume + 0.05); return accept; }
            if (event.text == Key.DownArrow) { root.set-volume(root.volume - 0.05); return accept; }
            if (event.text == "m" || event.text == "M") { root.toggle-mute(); return accept; }
            if (event.text == "v" || event.text == "V") { root.viz-fullscreen = true; return accept; }
            if (event.text == "s" || event.text == "S") { root.toggle-shuffle(); return accept; }
            if (event.text == "r" || event.text == "R") { root.cycle-repeat(); return accept; }
            if (event.text == "/") { search.focus-input(); return accept; }
            return reject;
        }

        VerticalLayout {
            visible: !root.mini-player;
            // Sidebar and pages. They may be cut off (never pushed out of the
            // window), so the now playing bar always stays visible.
            content-area := Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            clip: true;
            HorizontalLayout {

                // ---------------- Sidebar ----------------
                // Not on a phone: there the "More" menu and page take its place.
                Rectangle {
                    width: root.phone ? 0px : 232px;
                    visible: !root.phone;
                    clip: true;
                    background: Theme.sidebar.transparentize(Theme.see-through);
                    VerticalLayout {
                        padding: 16px;
                        padding-top: 20px + root.titlebar-inset;
                        spacing: root.phone ? 2px : 4px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-bottom: 18px;
                            spacing: 10px;
                            BrandMark {}
                        }
                        Text {
                            text: "LIBRARY";
                            color: Theme.fg-muted;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                        }
                        Rectangle { height: 2px; }
                        NavItem {
                            icon: @image-url("icons/album.svg");
                            label: "Albums";
                            selected: (root.page == 0 && !root.albums-filtered) || (root.page == 5 && !root.album-from-server-page);
                            clicked => {
                                if (root.albums-filtered) { root.show-all-albums(); }
                                root.page = 0;
                            }
                        }
                        NavItem {
                            icon: @image-url("icons/artist.svg");
                            label: "Artists";
                            selected: root.page == 1 || (root.page == 0 && root.albums-filtered);
                            clicked => {
                                if (root.albums-filtered) { root.show-all-albums(); }
                                root.page = 1;
                            }
                        }
                        NavItem {
                            icon: @image-url("icons/song.svg");
                            label: "Songs";
                            selected: root.page == 2;
                            clicked => { root.page = 2; }
                        }
                        NavItem {
                            icon: @image-url("icons/stats.svg");
                            label: "Statistics";
                            selected: root.page == 13;
                            clicked => { root.page = 13; }
                        }
                        Rectangle { height: 14px; }
                        Text {
                            text: "LISTEN";
                            color: Theme.fg-muted;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                        }
                        Rectangle { height: 2px; }
                        NavItem {
                            icon: @image-url("icons/radio.svg");
                            label: "Radio";
                            selected: root.page == 3;
                            clicked => { root.page = 3; }
                        }
                        NavItem {
                            icon: @image-url("icons/podcast.svg");
                            label: "Podcasts";
                            selected: root.page == 10;
                            clicked => { root.page = 10; }
                        }
                        NavItem {
                            icon: @image-url("icons/queue.svg");
                            label: "Queue";
                            selected: root.page == 4;
                            drop-target: true;
                            clicked => { root.page = 4; }
                            dropped(data) => { Dnd.dropped(data, -1); }
                        }
                        if root.servers.length > 0: Rectangle { height: 12px; }
                        if root.servers.length > 0: Text {
                            text: "SERVERS";
                            color: Theme.fg-muted;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                        }
                        for server[i] in root.servers: NavItem {
                            icon: @image-url("icons/server.svg");
                            label: server.name;
                            selected: (root.page == 9 || (root.page == 5 && root.album-from-server-page)) && root.current-server == i;
                            clicked => {
                                root.open-server(i);
                                root.page = 9;
                            }
                        }
                        Rectangle { height: 12px; }
                        HorizontalLayout {
                            Text {
                                horizontal-stretch: 1;
                                text: "PLAYLISTS";
                                color: Theme.fg-muted;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: @image-url("icons/import.svg");
                                size: 26px;
                                icon-size: 15px;
                                tint: Theme.fg-muted;
                                clicked => { root.import-playlist(); }
                            }
                            // Dropping songs here makes a new playlist of them.
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: new-drop.hot ? Theme.accent-soft : transparent;
                                border-width: Dnd.active ? 1px : 0px;
                                border-color: new-drop.hot ? Theme.accent : Theme.accent.transparentize(0.6);
                                new-drop := DropTarget {
                                    accepted(data) => { Dnd.dropped(data, -2); }
                                }
                                IconButton {
                                    icon: @image-url("icons/plus.svg");
                                    size: 26px;
                                    icon-size: 16px;
                                    tint: new-drop.hot ? Theme.accent : Theme.fg-muted;
                                    clicked => {
                                        root.new-playlist();
                                        root.page = 8;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 40px;
                        pl-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: pl-list.preferred-height;
                            pl-list := VerticalLayout {
                                width: pl-flick.width;
                                alignment: start;
                                spacing: 2px;
                                for pl[i] in root.playlists: NavItem {
                                    icon: @image-url("icons/playlist.svg");
                                    label: pl.name;
                                    selected: root.page == 8 && root.current-playlist == i;
                                    drop-target: true;
                                    clicked => {
                                        root.open-playlist(i);
                                        root.page = 8;
                                    }
                                    dropped(data) => { Dnd.dropped(data, i); }
                                }
                            }
                        }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PillButton {
                                horizontal-stretch: 1;
                                text: Theme.mobile ? "Find my music" : "Add folder";
                                icon: Theme.mobile ? @image-url("icons/search.svg") : @image-url("icons/plus.svg");
                                clicked => { root.add-folder(); }
                            }
                            IconButton {
                                icon: @image-url("icons/refresh.svg");
                                size: 38px;
                                icon-size: 18px;
                                enabled: !root.scanning;
                                clicked => { root.rescan(); }
                            }
                        }
                        if root.library-status != "": Text {
                            text: root.library-status;
                            color: Theme.fg-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            spacing: 8px;
                            ThemeSwitch {
                                horizontal-stretch: 1;
                                selected(mode) => {
                                    root.apply-theme(mode);
                                    root.theme-selected(mode);
                                }
                            }
                            IconButton {
                                icon: @image-url("icons/settings.svg");
                                size: 36px;
                                icon-size: 18px;
                                active: root.page == 7;
                                tint: Theme.fg-muted;
                                clicked => { root.page = 7; }
                            }
                        }
                    }
                }
                Rectangle { width: root.phone ? 0px : 1px; background: Theme.border; }

                // ---------------- Main area ----------------
                VerticalLayout {
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        height: (root.phone ? 56px : 68px) + root.titlebar-inset;
                        padding-top: root.titlebar-inset;
                        padding-left: root.phone ? 16px : 24px;
                        padding-right: root.phone ? 12px : 24px;
                        spacing: root.phone ? 6px : 12px;
                        if root.page == 5 || (root.page == 0 && root.albums-filtered): VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/back.svg");
                                size: 34px;
                                icon-size: 18px;
                                clicked => {
                                    if (root.page == 5) {
                                        root.page = root.album-from-server-page ? 9 : 0;
                                    } else {
                                        root.artist-back();
                                    }
                                }
                            }
                        }
                        if !(root.phone && root.search-open): Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text: root.phone && root.page == 0 && !root.albums-filtered ? "Music"
                                : root.page == 0 && root.albums-filtered ? "Artist"
                                : root.page == 0 ? root.albums-title
                                : root.phone && (root.page == 1 || root.page == 2) ? "Music"
                                : root.music-chips && root.page != 8 ? "Music"
                                // Phone: the title follows the selected chip.
                                : root.phone && root.page == 11 ? "Playlists"
                                : root.phone && root.page == 12 ? "Sources"
                                : root.page == 11 ? "Playlists"
                                : root.page == 1 ? "Artists"
                                : root.page == 2 ? "Songs"
                                : root.page == 3 ? "Radio"
                                : root.page == 4 ? "Queue"
                                : root.page == 6 ? "Now Playing"
                                : root.page == 7 ? "Settings"
                                : root.page == 8 ? "Playlist"
                                : root.page == 9 ? root.server-name
                                : root.page == 10 ? (root.podcast-view == 1 ? "Podcast" : "Podcasts")
                                : root.page == 13 ? "Statistics"
                                : "";
                            color: Theme.fg;
                            font-size: root.phone ? 21px : 24px;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // The library is being synced with the music folders
                        // (in the background; everything works meanwhile).
                        if root.scanning && !root.phone: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 30px;
                                width: sync-row.preferred-width + 24px;
                                border-radius: 15px;
                                background: Theme.accent-soft;
                                sync-row := HorizontalLayout {
                                    x: 12px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/refresh.svg");
                                            width: 14px;
                                            height: 14px;
                                            colorize: Theme.accent;
                                            transform-rotation: Math.mod(animation-tick() / 1ms, 1000) / 1000 * 360deg;
                                        }
                                    }
                                    Text {
                                        text: "Syncing library…";
                                        color: Theme.accent;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        // Sort order of the Albums, Artists and Songs pages.
                        if root.page <= 2 && !(root.phone && root.search-open): VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 4px;
                                sort-button := Rectangle {
                                    height: 34px;
                                    width: sort-row.preferred-width + 24px;
                                    border-radius: 17px;
                                    background: sort-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    sort-row := HorizontalLayout {
                                        x: 12px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("icons/sort.svg");
                                                width: 15px;
                                                height: 15px;
                                                colorize: Theme.fg-muted;
                                            }
                                        }
                                        // Phone: the icon alone (the order is ticked in the list).
                                        if !root.phone: Text {
                                            text: "Sort: " + root.sort-labels[root.sort-index];
                                            color: Theme.fg;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    sort-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { sort-popup.show(); }
                                    }
                                    sort-popup := PopupWindow {
                                        x: root.phone ? -110px : 0px;
                                        y: parent.height + 4px;
                                        width: 200px;
                                        height: sort-box.preferred-height;
                                        sort-box := Rectangle {
                                            border-radius: 12px;
                                            background: Theme.surface;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            drop-shadow-blur: 20px;
                                            drop-shadow-color: #00000050;
                                            VerticalLayout {
                                                padding: 6px;
                                                spacing: 1px;
                                                for label[i] in root.sort-labels: MenuRow {
                                                    text: label;
                                                    icon: i == root.sort-index ? @image-url("icons/check.svg") : @image-url("");
                                                    clicked => { root.set-sort(root.page, i); }
                                                }
                                            }
                                        }
                                    }
                                }
                                // Direction: high-to-low (↓) or low-to-high (↑).
                                IconButton {
                                    icon: root.sort-desc ? @image-url("icons/sort-desc.svg") : @image-url("icons/sort-asc.svg");
                                    size: 34px;
                                    icon-size: 16px;
                                    tint: Theme.fg-muted;
                                    clicked => { root.flip-sort(root.page); }
                                }
                            }
                        }
                        // Phone: Statistics opens from Settings.
                        if root.phone && root.page == 7: VerticalLayout {
                            alignment: center;
                            stats-button := Rectangle {
                                height: 36px;
                                width: stats-row.preferred-width + 24px;
                                border-radius: 18px;
                                background: stats-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;
                                stats-row := HorizontalLayout {
                                    x: 12px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/stats.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: Theme.fg;
                                        }
                                    }
                                    Text {
                                        text: "Statistics";
                                        color: Theme.fg;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }
                                stats-touch := TouchArea {
                                    clicked => { root.page = 13; }
                                }
                            }
                        }
                        // Phone: a search button that swaps the title for the search box.
                        if root.phone && !root.search-open && root.page != 6 && root.page != 7 && root.page != 4 && root.page != 8 && root.page != 5 && root.page != 11 && root.page != 12 && root.page != 13: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/search.svg");
                                size: 40px;
                                icon-size: 20px;
                                clicked => {
                                    root.search-open = true;
                                    search.focus-input();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            search := SearchBox {
                                width: !root.phone ? 280px : root.search-open ? content-area.width - 76px : 0px;
                                visible: !root.phone || root.search-open;
                                placeholder: root.page == 3 ? "Search radio stations"
                                    : root.page == 10 ? "Search podcasts or paste an RSS link"
                                    : "Search songs, artists, albums";
                                edited(text) => {
                                    if (root.page == 3) {
                                        root.radio-search(text);
                                    } else if (root.page == 10) {
                                        root.podcast-search(text);
                                    } else {
                                        root.library-search(text);
                                        if (root.phone) {
                                            if (text != "") { root.page = 2; }
                                        } else {
                                            // Suggestions; Enter shows every matching song.
                                            root.search-dropdown = text != "";
                                        }
                                    }
                                }
                                accepted => {
                                    if (!root.phone && root.page != 3 && root.page != 10 && self.text != "") {
                                        root.search-dropdown = false;
                                        root.page = 2;
                                    }
                                }
                                escaped => {
                                    root.search-dropdown = false;
                                    keys.focus();
                                }
                            }
                        }
                        // Phone playlists: import an M3U file, or make a new playlist.
                        if root.phone && root.page == 11: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/import.svg");
                                size: 40px;
                                icon-size: 19px;
                                tint: Theme.fg-muted;
                                clicked => { root.import-playlist(); }
                            }
                        }
                        if root.phone && root.page == 11: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/plus.svg");
                                size: 40px;
                                icon-size: 20px;
                                tint: Theme.fg-muted;
                                clicked => {
                                    root.new-playlist();
                                    root.page = 8;
                                }
                            }
                        }
                        if root.phone && root.search-open: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/close.svg");
                                size: 40px;
                                icon-size: 18px;
                                clicked => {
                                    root.search-open = false;
                                    keys.focus();
                                }
                            }
                        }
                    }

                    // Phone: which music the Song / Album / Artist views show.
                    if root.music-chips && (root.page == 0 || root.page == 1 || root.page == 2) && root.source-names.length > 0: Rectangle {
                        height: 44px;
                        clip: true;
                        src-chip-flick := Flickable {
                            width: parent.width;
                            height: 32px;
                            y: 0px;
                            content-width: src-chip-row.preferred-width;
                            content-height: self.height;
                            src-chip-row := HorizontalLayout {
                                width: src-chip-flick.content-width;
                                height: src-chip-flick.height;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: start;
                                Chip { text: "All"; selected: root.source-selected == 0; clicked => { root.select-source(0); } }
                                Chip { text: "Phone"; selected: root.source-selected == 1; clicked => { root.select-source(1); } }
                                for name[i] in root.source-names: Chip {
                                    text: name;
                                    selected: root.source-selected == i + 2;
                                    clicked => { root.select-source(i + 2); }
                                }
                            }
                        }
                    }
                    // Phone: the Now Playing screens.
                    if root.np-chips: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        alignment: start;
                        Chip { text: "Player"; selected: root.page == 6; clicked => { root.page = 6; } }
                        Chip { text: "Queue"; selected: root.page == 4; clicked => { root.page = 4; } }
                        Chip {
                            text: "Playlists";
                            selected: root.page == 11 || root.page == 8;
                            clicked => {
                                root.np-group = true;
                                root.page = 11;
                            }
                        }
                        Chip {
                            text: "Sources";
                            selected: root.page == 12;
                            clicked => {
                                root.page = 12;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        // Phone: the playlists.
                        if root.phone && root.page == 11: phone-pl-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: Math.max(self.height, phone-pl-list.preferred-height);
                            phone-pl-list := VerticalLayout {
                                width: phone-pl-flick.width;
                                alignment: start;
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 4px;
                                padding-bottom: 24px;
                                spacing: 2px;
                                for pl[i] in root.playlists: NavItem {
                                    icon: @image-url("icons/playlist.svg");
                                    label: pl.name;
                                    clicked => {
                                        root.open-playlist(i);
                                        root.page = 8;
                                    }
                                }
                                if root.playlists.length == 0: Text {
                                    text: "No playlists yet. Tap + to make one, or import an M3U playlist.";
                                    color: Theme.fg-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        // Phone: Sources, the music folders and servers.
                        if root.phone && root.page == 12: src-flick := Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: Math.max(self.height, src-list.preferred-height);
                            src-list := VerticalLayout {
                                width: src-flick.width;
                                alignment: start;
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 4px;
                                padding-bottom: 24px;
                                spacing: 2px;
                                Text {
                                    height: 30px;
                                    vertical-alignment: center;
                                    text: "FOLDERS";
                                    color: Theme.fg-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }
                                for folder in root.folders: HorizontalLayout {
                                    height: 46px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/folder.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: Theme.fg-muted;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        text: folder;
                                        color: Theme.fg;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                if root.folders.length == 0: Text {
                                    text: "No music folders yet.";
                                    color: Theme.fg-muted;
                                    font-size: 13px;
                                }
                                HorizontalLayout {
                                    padding-top: 8px;
                                    spacing: 8px;
                                    alignment: start;
                                    PillButton {
                                        text: Theme.mobile ? "Find my music" : "Add folder";
                                        icon: Theme.mobile ? @image-url("icons/search.svg") : @image-url("icons/plus.svg");
                                        clicked => { root.add-folder(); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/refresh.svg");
                                        size: 38px;
                                        icon-size: 18px;
                                        enabled: !root.scanning;
                                        clicked => { root.rescan(); }
                                    }
                                }
                                if root.library-status != "": Text {
                                    text: root.library-status;
                                    color: Theme.fg-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 16px; }
                                Text {
                                    height: 30px;
                                    vertical-alignment: center;
                                    text: "SERVERS";
                                    color: Theme.fg-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }
                                for server[i] in root.servers: NavItem {
                                    icon: @image-url("icons/server.svg");
                                    label: server.name;
                                    clicked => {
                                        root.server-from-sources = true;
                                        root.open-server(i);
                                        root.page = 9;
                                    }
                                }
                                if root.servers.length == 0: Text {
                                    text: "No music servers yet. Add Jellyfin, Plex, Navidrome or another Subsonic server.";
                                    color: Theme.fg-muted;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    padding-top: 8px;
                                    alignment: start;
                                    PillButton {
                                        text: "Add server";
                                        icon: @image-url("icons/plus.svg");
                                        clicked => { root.server-dialog = true; }
                                    }
                                }
                            }
                        }
                        if root.page == 0: AlbumsPage {
                            width: parent.width;
                            height: parent.height;
                            albums: root.albums;
                            library-empty: root.library-empty;
                            scanning: root.scanning;
                            playing-album: root.playing-album;
                            visible-range(first, last) => { root.album-range(first, last); }
                            open-album(i) => {
                                root.open-album(i);
                                root.page = 5;
                            }
                            add-folder => { root.add-folder(); }
                            covers-visible(first, last) => { root.albums-visible(first, last); }
                            artist-mode: root.albums-filtered;
                            artist-name: root.artist-name;
                            artist-info: root.artist-info;
                            artist-image: root.artist-image;
                            artist-has-image: root.artist-has-image;
                            play-artist(shuffled) => { root.play-artist(shuffled); }
                        }
                        if root.page == 9: ServerPage {
                            width: parent.width;
                            height: parent.height;
                            albums: root.server-albums;
                            status: root.server-status;
                            loading: root.server-loading;
                            playing-album: root.playing-album;
                            open-album(i) => {
                                root.open-server-album(i);
                                root.page = 5;
                            }
                            refresh => { root.refresh-server(); }
                            covers-visible(first, last) => { root.server-albums-visible(first, last); }
                        }
                        if root.page == 5: AlbumDetailPage {
                            width: parent.width;
                            height: parent.height;
                            album: root.album;
                            info: root.album-info;
                            genre: root.album-genre;
                            tracks: root.album-tracks;
                            current-key: root.current-key;
                            play(shuffled) => { root.play-album(shuffled); }
                            play-track(i) => { root.play-album-track(i); }
                            track-menu(i, x, y) => { root.show-track-menu(0, i, x, y); }
                            album-menu(x, y) => { root.show-track-menu(3, -1, x, y); }
                        density-changed(c) => {
                            Theme.compact = c;
                            root.density-changed(c);
                        }
                        }
                        if root.page == 1: ArtistsPage {
                            width: parent.width;
                            height: parent.height;
                            artists: root.artists;
                            visible-range(first, last) => { root.artist-range(first, last); }
                            open-artist(i) => {
                                root.open-artist(i);
                                root.page = 0;
                            }
                        }
                        if root.page == 2: SongsPage {
                            width: parent.width;
                            height: parent.height;
                            songs: root.songs;
                            current-key: root.current-key;
                            searching: root.library-query != "";
                            selection-count: root.song-selection-count;
                            play-song(i) => { root.play-song(i); }
                            track-menu(i, x, y) => { root.show-track-menu(1, i, x, y); }
                            toggle-selected(i) => { root.toggle-song-selected(i); }
                            clear-selection => { root.clear-song-selection(); }
                            selection-menu(x, y) => { root.show-track-menu(4, -1, x, y); }
                            song-swiped(i, right) => { return root.song-swiped(i, right); }
                        }
                        if root.page == 3: RadioPage {
                            width: parent.width;
                            height: parent.height;
                            stations: root.stations;
                            tab: root.radio-tab;
                            filter-labels: root.radio-filter-labels;
                            filter-active: root.radio-filter-active;
                            picker-title: root.radio-picker-title;
                            picker-items: root.radio-picker-items;
                            picker-loading: root.radio-picker-loading;
                            picker-query <=> root.radio-picker-query;
                            open-picker(k) => { root.radio-open-picker(k); }
                            picker-search(t) => { root.radio-picker-search(t); }
                            picker-pick(i) => { root.radio-picker-pick(i); }
                            filtered: root.radio-filtered;
                            genres-on: root.radio-genres;
                            loading: root.radio-loading;
                            status: root.radio-status;
                            current-key: root.current-key;
                            select-tab(t) => { root.radio-select-tab(t); }
                            genre(g) => { root.radio-genre(g); }
                            add-stream => { add-stream-popup.show(); }
                            play-station(i) => { root.play-station(i); }
                            toggle-favorite(i) => { root.toggle-favorite(i); }
                        }
                        if root.page == 13: StatisticsPage {
                            width: parent.width;
                            height: parent.height;
                            period: root.stats-period;
                            tiles: root.stats-tiles;
                            library-tiles: root.stats-library;
                            days: root.stats-days;
                            days-total: root.stats-days-total;
                            songs: root.stats-songs;
                            artists: root.stats-artists;
                            albums: root.stats-albums;
                            genres: root.stats-genres;
                            empty: root.stats-empty;
                            period-changed(p) => { root.stats-period-changed(p); }
                        }
                        if root.page == 10: PodcastsPage {
                            width: parent.width;
                            height: parent.height;
                            view: root.podcast-view;
                            searching: root.podcast-searching;
                            results: root.podcast-results;
                            shows: root.podcast-shows;
                            loading: root.podcast-loading;
                            status: root.podcast-status;
                            show-title: root.podcast-title;
                            show-author: root.podcast-author;
                            show-description: root.podcast-description;
                            show-image: root.podcast-image;
                            show-has-image: root.podcast-has-image;
                            episodes: root.podcast-episodes;
                            show-favorite: root.podcast-favorite;
                            current-key: root.current-key;
                            subscribe(i) => { root.podcast-subscribe(i); }
                            open-show(i) => { root.podcast-open(i); }
                            back => { root.podcast-back(); }
                            refresh => { root.podcast-refresh(); }
                            unsubscribe => { root.podcast-unsubscribe(); }
                            play-episode(i) => { root.podcast-play(i); }
                            toggle-favorite(i) => { root.podcast-toggle-favorite(i); }
                            toggle-show-favorite => { root.podcast-toggle-show-favorite(); }
                        }
                        // Phone: swipe left / right for the next / previous song,
                        // up for the lyrics, down to close the player.
                        if root.page == 6: np-swipe := SwipeGestureHandler {
                            width: parent.width;
                            height: parent.height;
                            enabled: root.phone && !root.eq-open;
                            handle-swipe-left: root.has-track;
                            handle-swipe-right: root.has-track;
                            handle-swipe-up: !root.lyrics-open && !root.is-radio && root.has-track;
                            handle-swipe-down: !root.lyrics-open;
                            swiped => {
                                if (Math.abs(self.current-position.x - self.pressed-position.x) > Math.abs(self.current-position.y - self.pressed-position.y)) {
                                    if (self.current-position.x < self.pressed-position.x) { root.next(); } else { root.previous(); }
                                } else if (self.current-position.y < self.pressed-position.y) {
                                    root.lyrics-open-changed(true);
                                } else {
                                    root.music-group = root.before-player-music;
                                    root.page = root.before-player;
                                }
                            }
                            NowPlayingPage {
                                width: parent.width;
                                height: parent.height;
                                title: root.np-title;
                                subtitle: root.np-subtitle;
                                cover: root.np-cover;
                                has-cover: root.np-has-cover;
                                backdrop: root.np-backdrop;
                                has-backdrop: root.np-has-backdrop;
                                is-radio: root.is-radio;
                                has-track: root.has-track;
                                playing: root.playing;
                                bars: root.viz-bars;
                                peaks: root.viz-peaks;
                                viz-style: root.viz-style;
                                path-a: root.viz-path-a;
                                path-b: root.viz-path-b;
                                covered: root.viz-fullscreen;
                                open-fullscreen => { root.viz-fullscreen = true; }
                                step-viz(d) => { root.step-viz(d); }
                                eq-open: root.eq-open;
                                eq-enabled: root.eq-enabled;
                                eq-gains: root.eq-gains;
                                eq-preamp: root.eq-preamp;
                                eq-preset: root.eq-preset;
                                eq-curve: root.eq-curve;
                                eq-open-changed(o) => { root.eq-open-changed(o); }
                                eq-toggle(on) => { root.eq-toggle(on); }
                                eq-preset-selected(i) => { root.eq-preset-selected(i); }
                                eq-band-changed(i, v) => { root.eq-band-changed(i, v); }
                                eq-preamp-changed(v) => { root.eq-preamp-changed(v); }
                                eq-reset => { root.eq-reset(); }
                                eq-curve-aspect(a) => { root.eq-curve-aspect(a); }
                                can-like: root.np-can-like;
                                liked: root.np-liked;
                                toggle-like => { root.toggle-like(); }
                                lyrics-open: root.lyrics-open;
                                lyrics-lines: root.lyrics-lines;
                                lyrics-current: root.lyrics-current;
                                lyrics-synced: root.lyrics-synced;
                                lyrics-status: root.lyrics-status;
                                lyrics-source: root.lyrics-source;
                                lyrics-can-save: root.lyrics-can-save;
                                save-lyrics(kind) => { root.save-lyrics(kind); }
                                lyrics-open-changed(o) => { root.lyrics-open-changed(o); }
                            }
                        }
                        if root.page == 8: PlaylistPage {
                        width: parent.width;
                        height: parent.height;
                        name: root.playlist-name;
                        info: root.playlist-info;
                        tracks: root.playlist-tracks;
                        current-key: root.current-key;
                        play(shuffled) => { root.play-playlist(shuffled); }
                        play-track(i) => { root.play-playlist-track(i); }
                        rename(name) => { root.rename-playlist(name); }
                        delete => { root.delete-playlist(); }
                        export => { root.export-playlist(); }
                        track-menu(i, x, y) => { root.show-track-menu(2, i, x, y); }
                        move-track(from, to) => { root.move-playlist-track(from, to); }
                        density-changed(c) => {
                            Theme.compact = c;
                            root.density-changed(c);
                        }
                    }
                    if root.page == 7: SettingsPage {
                            width: parent.width;
                            height: parent.height;
                            folders: root.folders;
                            version: root.app-version;
                            log-path: root.log-path;
                            scanning: root.scanning;
                            download-art: root.download-art;
                            servers: root.servers;
                            add-server => {
                                root.server-dialog = true;
                            }
                            remove-server(i) => { root.remove-server(i); }
                            open-server(i) => {
                                root.server-from-sources = false;
                                root.open-server(i);
                                root.page = 9;
                            }
                            download-art-changed(on) => {
                                root.download-art = on;
                                root.download-art-changed(on);
                            }
                            sort-ignore-articles: root.sort-ignore-articles;
                            sort-ignore-articles-changed(on) => {
                                root.sort-ignore-articles = on;
                                root.sort-ignore-articles-changed(on);
                            }
                            theme-selected(mode) => {
                                root.apply-theme(mode);
                                root.theme-selected(mode);
                            }
                            opacity-changed(v) => { root.opacity-changed(v); }
                            glass-available: root.glass-available;
                            glass: root.glass;
                            glass-changed(on) => { root.glass-changed(on); }
                            glass-countdown: root.glass-countdown;
                            glass-keep => { root.glass-keep(); }
                            crossfade: root.crossfade;
                            crossfade-changed(secs) => { root.crossfade-changed(secs); }
                            gapless-albums: root.gapless-albums;
                            gapless-albums-changed(on) => { root.gapless-albums-changed(on); }
                            lyrics-online: root.lyrics-online;
                            lyrics-online-changed(on) => { root.lyrics-online-changed(on); }
                            lyrics-autosave: root.lyrics-autosave;
                            lyrics-autosave-changed(v) => { root.lyrics-autosave-changed(v); }
                            startup-sound: root.startup-sound;
                            startup-sound-changed(on) => { root.startup-sound-changed(on); }
                            resume-session: root.resume-session;
                            resume-session-changed(on) => { root.resume-session-changed(on); }
                        density-changed(c) => {
                            Theme.compact = c;
                            root.density-changed(c);
                        }
                            add-folder => { root.add-folder(); }
                            remove-folder(i) => { root.remove-folder(i); }
                            rescan => { root.rescan(); }
                        }
                        if root.page == 4: QueuePage {
                            width: parent.width;
                            height: parent.height;
                            queue: root.queue;
                            play-index(i) => { root.play-queue-index(i); }
                            remove-index(i) => { root.remove-queue-index(i); }
                            clear => { root.clear-queue(); }
                        save-as-playlist => { root.save-queue-as-playlist(); }
                        move-index(from, to) => { root.move-queue-index(from, to); }
                        }
                    }

                }
            }
            }

            // ---------------- Now playing bar ----------------
            Rectangle { height: 1px; background: Theme.border; }

            // Phone, on the Now Playing page: the full transport.
            if root.phone && root.page == 6: Rectangle {
                height: 128px;
                background: Theme.bar;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 44px;
                            text: root.position-text;
                            color: Theme.fg-muted;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        SeekBar {
                            horizontal-stretch: 1;
                            value: root.position;
                            enabled: root.seekable;
                            changed(v) => { root.seek(v); }
                        }
                        Text {
                            width: 44px;
                            text: root.duration-text;
                            color: root.is-radio ? Theme.accent : Theme.fg-muted;
                            font-size: 12px;
                            font-weight: root.is-radio ? 700 : 400;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        alignment: space-around;
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/shuffle.svg");
                                size: 44px;
                                icon-size: 20px;
                                active: root.shuffle;
                                tint: Theme.fg-muted;
                                clicked => { root.toggle-shuffle(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/previous.svg");
                                size: 52px;
                                icon-size: 26px;
                                enabled: root.has-track;
                                clicked => { root.previous(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                primary: true;
                                size: 60px;
                                icon-size: 28px;
                                clicked => { root.toggle-play(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/next.svg");
                                size: 52px;
                                icon-size: 26px;
                                enabled: root.has-track;
                                clicked => { root.next(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: root.repeat-mode == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg");
                                size: 44px;
                                icon-size: 20px;
                                active: root.repeat-mode > 0;
                                tint: Theme.fg-muted;
                                clicked => { root.cycle-repeat(); }
                            }
                        }
                    }
                }
            }

            // Phone, on every other page: a small player. A tap on the cover
            // plays or stops; a tap on the rest (or a swipe up) opens Now
            // Playing, holding it the Queue. Swipe left: next song, swipe
            // right: previous song. The button on the right skips to the
            // next song.
            if root.phone && root.page != 6: Rectangle {
                property <bool> band-holding: false;
                property <bool> band-held: false;
                height: 64px;
                background: Theme.bar;
                band-timer := Timer {
                    interval: 500ms;
                    running: parent.band-holding;
                    triggered => {
                        parent.band-holding = false;
                        parent.band-held = true;
                        root.music-group = false;
                        root.page = 4;
                    }
                }
                band-touch := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            parent.band-held = false;
                            parent.band-holding = true;
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            parent.band-holding = false;
                        }
                    }
                    moved => {
                        if (!self.pressed || parent.band-held) { return; }
                        if (Math.abs((self.mouse-x - self.pressed-x) / 1px) > 10) { parent.band-holding = false; }
                        // Swipe up: Now Playing.
                        if (self.pressed-y - self.mouse-y > 24px) {
                            parent.band-holding = false;
                            parent.band-held = true;
                            root.page = 6;
                        }
                        // Swipe left / right: next / previous song.
                        if (root.has-track && Math.abs(self.mouse-x - self.pressed-x) > 56px) {
                            parent.band-holding = false;
                            parent.band-held = true;
                            if (self.mouse-x < self.pressed-x) { root.next(); } else { root.previous(); }
                        }
                    }
                    clicked => {
                        if (parent.band-held) { parent.band-held = false; return; }
                        root.page = 6;
                    }
                }
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * Math.max(0, Math.min(1, root.position));
                    height: 2px;
                    background: Theme.accent;
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            Artwork {
                                size: 48px;
                                source: root.np-cover;
                                has-image: root.np-has-cover;
                                placeholder: root.is-radio ? @image-url("icons/radio.svg") : @image-url("icons/song.svg");
                            }
                            // The play / stop overlay: white, on a soft shade.
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 16px;
                                background: art-touch.pressed ? #00000099 : #00000066;
                                Image {
                                    source: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: #ffffff;
                                }
                            }
                            art-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-play(); }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            min-width: 0px;
                            preferred-width: 0px;
                            text: root.np-title;
                            color: Theme.fg;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            min-width: 0px;
                            preferred-width: 0px;
                            text: root.buffering ? "Buffering…" : root.np-subtitle;
                            color: Theme.fg-muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/next.svg");
                            size: 48px;
                            icon-size: 24px;
                            enabled: root.has-track;
                            clicked => { root.next(); }
                        }
                    }
                }
            }

            // Phone: Music's views, between the small player and the tabs
            // (search and the source filter stay at the top).
            if root.music-chips: Rectangle {
                background: Theme.sidebar;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 6px;
                    alignment: center;
                    Chip {
                        text: "Song";
                        selected: root.page == 2;
                        clicked => {
                            root.music-group = false;
                            root.page = 2;
                        }
                    }
                    Chip {
                        text: "Album";
                        selected: root.page == 0;
                        clicked => {
                            root.music-group = false;
                            if (root.albums-filtered) { root.show-all-albums(); }
                            root.page = 0;
                        }
                    }
                    Chip {
                        text: "Artist";
                        selected: root.page == 1;
                        clicked => {
                            root.music-group = false;
                            root.page = 1;
                        }
                    }
                    Chip {
                        text: "Q";
                        selected: root.page == 4;
                        clicked => {
                            root.music-group = true;
                            root.page = 4;
                        }
                    }
                    Chip {
                        text: "Playlist";
                        selected: root.page == 11 || root.page == 8;
                        clicked => {
                            root.music-group = true;
                            root.np-group = false;
                            root.page = 11;
                        }
                    }
                }
            }

            // Phone: tabs.
            if root.phone: Rectangle {
                height: 58px;
                background: Theme.sidebar;
                if !root.music-chips: Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    for tab[i] in [
                        { icon: @image-url("icons/song.svg"), label: "Music", page: 2 },
                        { icon: @image-url("icons/radio.svg"), label: "Radio", page: 3 },
                        { icon: @image-url("icons/podcast.svg"), label: "Podcasts", page: 10 },
                        { icon: @image-url("icons/settings.svg"), label: "Settings", page: 7 },
                    ]: Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: tab.icon;
                                    width: 22px;
                                    height: 22px;
                                    colorize: root.active-tab == i ? Theme.accent : Theme.fg-muted;
                                }
                            }
                            Text {
                                text: tab.label;
                                color: root.active-tab == i ? Theme.accent : Theme.fg-muted;
                                font-size: 11px;
                                font-weight: root.active-tab == i ? 700 : 400;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                if (i == 0) {
                                    // Music: back to the view last shown; tapped
                                    // again on an artist's albums, all albums.
                                    if (root.active-tab == 0 && root.page == 0 && root.albums-filtered) {
                                        root.show-all-albums();
                                    }
                                    if (root.page == 5 && !root.album-from-server-page) {
                                        root.page = 0;
                                    } else {
                                        root.music-group = root.music-page == 4 || root.music-page == 11;
                                        root.page = root.music-page;
                                    }
                                    return;
                                }
                                root.np-group = false;
                                root.music-group = false;
                                root.page = tab.page;
                            }
                        }
                    }
                }
            }

            if !root.phone: Rectangle {
                height: 88px;
                background: Theme.bar.transparentize(Theme.see-through);
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 20px;
                    spacing: 16px;

                    Rectangle {
                        width: 300px;
                        np-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.page = 6; }
                        }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Artwork {
                                size: 58px;
                                source: root.np-cover;
                                has-image: root.np-has-cover;
                                placeholder: root.is-radio ? @image-url("icons/radio.svg") : @image-url("icons/song.svg");
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: root.np-title;
                                color: Theme.fg;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: root.buffering ? "Buffering…" : root.np-subtitle;
                                color: Theme.fg-muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Rectangle {
                        height: transport.preferred-height;
                        transport := HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("icons/shuffle.svg");
                                    size: 32px;
                                    icon-size: 18px;
                                    active: root.shuffle;
                                    tint: Theme.fg-muted;
                                    clicked => { root.toggle-shuffle(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("icons/previous.svg");
                                    enabled: root.has-track;
                                    clicked => { root.previous(); }
                                }
                            }
                            IconButton {
                                icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                primary: true;
                                size: 44px;
                                icon-size: 22px;
                                clicked => { root.toggle-play(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("icons/next.svg");
                                    enabled: root.has-track;
                                    clicked => { root.next(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: root.repeat-mode == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg");
                                    size: 32px;
                                    icon-size: 18px;
                                    active: root.repeat-mode > 0;
                                    tint: Theme.fg-muted;
                                    clicked => { root.cycle-repeat(); }
                                }
                            }
                        }
                        // Like, above the end of the track length, level with the
                        // play controls. Always shown; greyed out when nothing
                        // likeable plays (radio, podcasts). Same as on Now Playing.
                        IconButton {
                            x: parent.width - 53px;
                            y: (parent.height - self.height) / 2;
                            enabled: root.np-can-like;
                            icon: root.np-liked ? @image-url("icons/heart-filled.svg") : @image-url("icons/heart.svg");
                            size: 32px;
                            icon-size: 18px;
                            active: root.np-liked;
                            tint: Theme.fg-muted;
                            clicked => { root.toggle-like(); }
                        }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                width: 48px;
                                text: root.position-text;
                                color: Theme.fg-muted;
                                font-size: 11px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            SeekBar {
                                horizontal-stretch: 1;
                                value: root.position;
                                enabled: root.seekable;
                                changed(v) => { root.seek(v); }
                            }
                            Text {
                                width: 48px;
                                text: root.duration-text;
                                color: root.is-radio ? Theme.accent : Theme.fg-muted;
                                font-size: 11px;
                                font-weight: root.is-radio ? 700 : 400;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        width: 300px;
                        alignment: end;
                        spacing: 8px;
                        Rectangle {
                            width: 104px;
                            mini := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.page = 6; }
                            }
                            Spectrum {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                height: 30px;
                                gap: 3px;
                                bars: root.mini-bars;
                                peaks: root.mini-peaks;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/mini-player.svg");
                                size: 32px;
                                icon-size: 18px;
                                tint: Theme.fg-muted;
                                clicked => { root.toggle-mini-player(); }
                            }
                        }
                        // Volume: click the speaker to mute / unmute; the mouse
                        // wheel over the speaker or the bar changes the volume.
                        volume-box := Rectangle {
                            width: volume-row.preferred-width;
                            wheel := TouchArea {
                                scroll-event(event) => {
                                    if (event.delta-y == 0px) { return reject; }
                                    // Mouse wheel notch: 5 %; smooth trackpad scrolling: finer steps.
                                    root.set-volume(root.volume + (Math.abs(event.delta-y / 1px) >= 10
                                        ? (event.delta-y > 0px ? 0.05 : -0.05)
                                        : event.delta-y / 1px * 0.005));
                                    return accept;
                                }
                            }
                            volume-row := HorizontalLayout {
                                spacing: 2px;
                                VerticalLayout {
                                    alignment: center;
                                    mute := Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: mute-touch.has-hover ? Theme.fg.transparentize(0.9) : transparent;
                                        Image {
                                            source: root.volume <= 0.001 ? @image-url("icons/volume-off.svg") : @image-url("icons/volume.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: root.volume <= 0.001 ? Theme.accent : (mute-touch.has-hover ? Theme.fg : Theme.fg-muted);
                                        }
                                        mute-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-mute(); }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    // 300px for spectrum, mini player button and volume.
                                    SeekBar {
                                        width: 110px;
                                        value: root.volume;
                                        changed(v) => { root.set-volume(v); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------------- Mini player ----------------
        if root.mini-player: Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.bar.transparentize(Theme.see-through);
            VerticalLayout {
                padding: 12px;
                padding-top: 12px + root.titlebar-inset;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        Artwork {
                            size: 64px;
                            source: root.np-cover;
                            has-image: root.np-has-cover;
                            placeholder: root.is-radio ? @image-url("icons/radio.svg") : @image-url("icons/album.svg");
                        }
                        // Double-click the cover: back to the full player.
                        TouchArea {
                            mouse-cursor: pointer;
                            double-clicked => { root.toggle-mini-player(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            min-width: 0px;
                            preferred-width: 0px;
                            text: root.np-title;
                            color: Theme.fg;
                            font-size: 14px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            min-width: 0px;
                            preferred-width: 0px;
                            text: root.np-subtitle;
                            color: Theme.fg-muted;
                            font-size: 12px;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            alignment: start;
                            IconButton {
                                icon: @image-url("icons/previous.svg");
                                size: 32px;
                                icon-size: 18px;
                                enabled: root.has-track;
                                clicked => { root.previous(); }
                            }
                            IconButton {
                                icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                primary: true;
                                size: 34px;
                                icon-size: 18px;
                                clicked => { root.toggle-play(); }
                            }
                            IconButton {
                                icon: @image-url("icons/next.svg");
                                size: 32px;
                                icon-size: 18px;
                                enabled: root.has-track;
                                clicked => { root.next(); }
                            }
                            IconButton {
                                enabled: root.np-can-like;
                                icon: root.np-liked ? @image-url("icons/heart-filled.svg") : @image-url("icons/heart.svg");
                                size: 32px;
                                icon-size: 16px;
                                active: root.np-liked;
                                tint: Theme.fg-muted;
                                clicked => { root.toggle-like(); }
                            }
                            // Show / hide the line of lyrics.
                            IconButton {
                                icon: @image-url("icons/lyrics.svg");
                                size: 32px;
                                icon-size: 16px;
                                active: root.mini-lyrics;
                                tint: root.mini-lyrics ? Theme.accent : Theme.fg-muted;
                                clicked => { root.toggle-mini-lyrics(); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        // Back to the full player.
                        IconButton {
                            icon: @image-url("icons/expand.svg");
                            size: 28px;
                            icon-size: 16px;
                            tint: Theme.fg-muted;
                            clicked => { root.toggle-mini-player(); }
                        }
                        // Keep on top of other windows (on by default).
                        IconButton {
                            icon: @image-url("icons/pin.svg");
                            size: 28px;
                            icon-size: 15px;
                            active: root.mini-on-top;
                            tint: root.mini-on-top ? Theme.accent : Theme.fg-muted;
                            clicked => { root.mini-on-top = !root.mini-on-top; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.position-text;
                        color: Theme.fg-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    SeekBar {
                        horizontal-stretch: 1;
                        value: root.position;
                        enabled: root.seekable;
                        changed(v) => { root.seek(v); }
                    }
                    Text {
                        text: root.duration-text;
                        color: root.is-radio ? Theme.accent : Theme.fg-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 4px; }
                    // Volume: click the speaker to mute, mouse wheel to change.
                    Rectangle {
                        width: mini-vol.preferred-width;
                        TouchArea {
                            scroll-event(event) => {
                                if (event.delta-y == 0px) { return reject; }
                                root.set-volume(root.volume + (Math.abs(event.delta-y / 1px) >= 10
                                    ? (event.delta-y > 0px ? 0.05 : -0.05)
                                    : event.delta-y / 1px * 0.005));
                                return accept;
                            }
                        }
                        mini-vol := HorizontalLayout {
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    Image {
                                        source: root.volume <= 0.001 ? @image-url("icons/volume-off.svg") : @image-url("icons/volume.svg");
                                        width: 16px;
                                        height: 16px;
                                        x: 3px;
                                        y: 3px;
                                        colorize: root.volume <= 0.001 ? Theme.accent : Theme.fg-muted;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-mute(); }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                SeekBar {
                                    width: 70px;
                                    value: root.volume;
                                    changed(v) => { root.set-volume(v); }
                                }
                            }
                        }
                    }
                }
                // The line of the lyrics being sung (synced lyrics), or why
                // there is none.
                if root.mini-lyrics: Rectangle {
                    height: 26px;
                    border-radius: 8px;
                    background: Theme.fg.transparentize(0.94);
                    property <bool> has-line: root.lyrics-synced && root.lyrics-current >= 0
                        && root.lyrics-current < root.lyrics-lines.length;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: parent.has-line ? root.lyrics-lines[root.lyrics-current]
                            : root.lyrics-synced ? "♪"
                            : root.lyrics-lines.length > 0 ? "These lyrics aren't synced: open Now Playing to read them"
                            : root.lyrics-status;
                        color: parent.has-line ? Theme.fg : Theme.fg-muted;
                        font-size: parent.has-line ? 13px : 12px;
                        font-weight: parent.has-line ? 600 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // ---------------- Song menu ----------------
    track-menu := PopupWindow {
        width: 240px;
        height: menu-box.preferred-height;
        x: Math.max(8px, Math.min(root.menu-x - 212px, root.width - 248px));
        y: Math.max(8px, Math.min(root.menu-y, root.height - self.height - 8px));
        menu-box := Rectangle {
            border-radius: 12px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                // Context 4 is "Add to Playlist…" for the picked songs: playlists only.
                if root.menu-context != 4: MenuRow {
                    text: root.menu-context == 3 ? "Play album next" : "Play next";
                    icon: @image-url("icons/next.svg");
                    clicked => { root.track-menu-action(0, -1); }
                }
                if root.menu-context != 4: MenuRow {
                    text: "Add to queue";
                    icon: @image-url("icons/queue.svg");
                    clicked => { root.track-menu-action(1, -1); }
                }
                if root.menu-context != 4: Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: 10px;
                    height: 26px;
                    Text {
                        text: "ADD TO PLAYLIST";
                        color: Theme.fg-muted;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }
                for pl[i] in root.playlists: MenuRow {
                    text: pl.name;
                    icon: @image-url("icons/playlist.svg");
                    clicked => { root.track-menu-action(2, i); }
                }
                MenuRow {
                    text: "New playlist";
                    icon: @image-url("icons/plus.svg");
                    clicked => { root.track-menu-action(3, -1); }
                }
                if root.menu-context == 3 && !root.album-from-server: Rectangle { height: 1px; background: Theme.border; }
                if root.menu-context == 3 && !root.album-from-server: MenuRow {
                    text: "Fix album info…";
                    icon: @image-url("icons/album.svg");
                    clicked => { root.track-menu-action(5, -1); }
                }
                if root.menu-context == 2: Rectangle { height: 1px; background: Theme.border; }
                if root.menu-context == 2: MenuRow {
                    text: "Move to top";
                    icon: @image-url("icons/move-top.svg");
                    clicked => { root.track-menu-action(6, -1); }
                }
                if root.menu-context == 2: MenuRow {
                    text: "Move to bottom";
                    icon: @image-url("icons/move-bottom.svg");
                    clicked => { root.track-menu-action(7, -1); }
                }
                if root.menu-context == 2: MenuRow {
                    text: "Remove from playlist";
                    icon: @image-url("icons/trash.svg");
                    danger: true;
                    clicked => { root.track-menu-action(4, -1); }
                }
            }
        }
    }

    // ---------------- "Add stream URL" dialog ----------------
    add-stream-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: root.phone ? root.safe-area-insets.top + 24px : (root.height - 250px) / 2;
        width: Math.min(440px, root.width - 24px);
        height: 250px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Add a radio stream";
                    color: Theme.fg;
                    font-size: 16px;
                    font-weight: 700;
                }
                stream-name := TextField { placeholder: "Name (optional)"; }
                stream-url := TextField {
                    placeholder: "Stream address, e.g. https://example.com/live.mp3";
                    accepted => {
                        root.add-custom-stream(stream-name.text, stream-url.text);
                        add-stream-popup.close();
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    PillButton {
                        text: "Cancel";
                        has-icon: false;
                        clicked => { add-stream-popup.close(); }
                    }
                    PillButton {
                        text: "Add to Favorites";
                        has-icon: false;
                        primary: true;
                        clicked => {
                            root.add-custom-stream(stream-name.text, stream-url.text);
                            add-stream-popup.close();
                        }
                    }
                }
            }
        }
    }

    // ---------------- "Add server" dialog ----------------
    if root.server-dialog: Rectangle {
        background: #00000080;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-server-dialog();
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            width: Math.min(480px, root.width - (root.phone ? 24px : 48px));
            height: server-box.preferred-height;
            // Phone: near the top, so the on-screen keyboard doesn't cover it.
            y: root.phone ? root.safe-area-insets.top + 24px : (parent.height - self.height) / 2;
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000060;
            TouchArea { }
            server-box := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: "Add a music server";
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 700;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Chip { text: "Jellyfin"; selected: root.server-kind == 0; clicked => { root.server-kind = 0; } }
                    Chip { text: "Plex"; selected: root.server-kind == 1; clicked => { root.server-kind = 1; } }
                    Chip { text: root.phone ? "Navidrome" : "Navidrome / Subsonic"; selected: root.server-kind == 2; clicked => { root.server-kind = 2; } }
                }
                // Plex: servers found on the network. Searching runs in the
                // background; the address box below stays usable.
                if root.server-kind == 1: VerticalLayout {
                    spacing: 2px;
                    init => { root.find-plex(); }
                    for name[i] in root.plex-found: NavItem {
                        icon: @image-url("icons/server.svg");
                        label: name;
                        clicked => { root.pick-plex(i); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        height: 30px;
                        if root.plex-searching: Spinner {
                            indeterminate: true;
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            vertical-alignment: center;
                            text: root.plex-searching ? "Looking for Plex servers on your network…"
                                : root.plex-found.length == 0 ? "No Plex server found on your network."
                                : "Tap a server, or enter an address.";
                            color: Theme.fg-muted;
                            font-size: 12px;
                        }
                        if !root.plex-searching: IconButton {
                            icon: @image-url("icons/refresh.svg");
                            size: 30px;
                            icon-size: 15px;
                            clicked => { root.find-plex(); }
                        }
                    }
                }
                server-url := TextField {
                    text <=> root.server-url-text;
                    placeholder: root.server-kind == 0 ? "Address, e.g. 192.168.1.10 or http://nas:8096"
                        : root.server-kind == 2 ? "Address, e.g. 192.168.1.10 or http://nas:4533"
                        : "Server address (optional, found automatically)";
                    accepted => { root.connect-server(root.server-kind, server-url.text, root.server-user-text, root.server-secret-text); }
                }
                if root.server-kind != 1: VerticalLayout {
                    spacing: 12px;
                    TextField {
                        placeholder: "User name";
                        text <=> root.server-user-text;
                    }
                    TextField {
                        placeholder: "Password";
                        input-type: InputType.password;
                        text <=> root.server-secret-text;
                        accepted => { root.connect-server(root.server-kind, server-url.text, root.server-user-text, root.server-secret-text); }
                    }
                }
                Text {
                    text: root.server-dialog-status != "" ? root.server-dialog-status
                        : root.server-kind == 0
                            ? "Your password is only used to sign in; Unitn keeps the access token the server gives it."
                        : root.server-kind == 2
                            ? "Works with Navidrome, Gonic, Airsonic and other OpenSubsonic servers. Unitn keeps a salted token, never your password."
                            : "Unitn connects without signing in if your Plex server allows your network. Otherwise you sign in on plex.tv in your browser (two-factor sign-in works).";
                    color: root.server-dialog-status != "" ? Theme.fg : Theme.fg-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    PillButton {
                        text: "Cancel";
                        has-icon: false;
                        clicked => { root.close-server-dialog(); }
                    }
                    PillButton {
                        text: root.server-kind == 1
                            ? (root.server-connecting ? "Connecting…" : "Connect")
                            : (root.server-connecting ? "Connecting…" : "Connect");
                        has-icon: false;
                        primary: true;
                        clicked => { root.connect-server(root.server-kind, server-url.text, root.server-user-text, root.server-secret-text); }
                    }
                }
            }
        }
    }

    // ---------------- "Fix album info" dialog ----------------
    if root.fix-visible: Rectangle {
        background: #00000080;
        TouchArea { }  // modal: swallow clicks outside the dialog
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.fix-cancel();
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            width: Math.min(760px, root.width - (root.phone ? 16px : 48px));
            height: Math.min(580px, root.height - 48px - root.safe-area-insets.top - root.safe-area-insets.bottom);
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000060;
            TouchArea { }
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Fix album info";
                        color: Theme.fg;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Search MusicBrainz for the right album and pick it, or type the names yourself. You can also use your own image as the cover.";
                        color: Theme.fg-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    TextField {
                        placeholder: "Artist";
                        text <=> root.fix-artist;
                        accepted => { root.fix-search(root.fix-artist, root.fix-album); }
                    }
                    TextField {
                        placeholder: "Album";
                        text <=> root.fix-album;
                        accepted => { root.fix-search(root.fix-artist, root.fix-album); }
                    }
                    PillButton {
                        text: "Search";
                        icon: @image-url("icons/search.svg");
                        clicked => { root.fix-search(root.fix-artist, root.fix-album); }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;
                        Artwork {
                            size: root.phone ? 96px : 190px;
                            source: root.fix-preview;
                            has-image: root.fix-has-preview;
                        }
                        if !Theme.mobile: PillButton {
                            text: "Choose image…";
                            icon: @image-url("icons/album.svg");
                            clicked => { root.fix-choose-image(); }
                        }
                        Text {
                            width: root.phone ? 96px : 190px;
                            text: root.fix-status;
                            color: Theme.fg-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        if root.fix-candidates.length == 0: Text {
                            text: root.fix-busy ? "Searching…" : "No results yet";
                            color: Theme.fg-muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ListView {
                            horizontal-scrollbar-policy: always-off;
                            for c[i] in root.fix-candidates: Rectangle {
                                height: 60px;
                                // Highlight, kept clear of the scrollbar lane.
                                Rectangle {
                                    x: 0px;
                                    width: parent.width - Theme.scroll-gutter;
                                    height: parent.height;
                                    border-radius: 0px;
                                    background: i == root.fix-selected ? Theme.accent-soft
                                        : row-touch.has-hover ? Theme.surface-hover
                                        : Math.mod(i, 2) == 1 ? (Theme.dark ? #ffffff0a : #0000000a) : transparent;
                                }
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.fix-select(i); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px + Theme.scroll-gutter;
                                    spacing: 12px;
                                    VerticalLayout {
                                        alignment: center;
                                        Artwork {
                                            size: 44px;
                                            source: c.thumb;
                                            has-image: c.has-thumb;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: c.title;
                                            color: Theme.fg;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: c.info;
                                            color: Theme.fg-muted;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    PillButton {
                        text: "Cancel";
                        has-icon: false;
                        clicked => { root.fix-cancel(); }
                    }
                    PillButton {
                        text: root.fix-busy ? "Saving…" : "Save";
                        has-icon: false;
                        primary: true;
                        clicked => { root.fix-save(root.fix-artist, root.fix-album); }
                    }
                }
            }
        }
    }

    // ---------------- Full-screen visualizer ----------------
    if root.viz-fullscreen: full-viz := Rectangle {
        // A tap plays or stops (once it is clear it is not a double tap);
        // a double tap likes or unlikes the song, shown by a heart.
        property <bool> heart-show: false;
        property <bool> heart-liked: false;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.dark ? #050508 : Theme.bg;
        tap-timer := Timer {
            interval: 300ms;
            running: false;
            triggered => {
                self.running = false;
                root.toggle-play();
            }
        }
        heart-timer := Timer {
            interval: 1s;
            running: false;
            triggered => {
                self.running = false;
                full-viz.heart-show = false;
            }
        }

        if root.np-has-backdrop: Image {
            width: parent.width;
            height: parent.height;
            source: root.np-backdrop;
            image-fit: ImageFit.cover;
            opacity: Theme.dark ? 0.3 : 0.22;
        }

        Visualizer {
            x: parent.width * 0.06;
            y: parent.height * 0.08;
            width: parent.width * 0.88;
            height: parent.height * 0.72;
            style: root.viz-style;
            bars: root.viz-bars;
            peaks: root.viz-peaks;
            path-a: root.viz-path-a;
            path-b: root.viz-path-b;
            cover: root.np-cover;
            has-cover: root.np-has-cover;
            gap: 5px;
        }

        FocusScope {
            width: parent.width;
            height: parent.height;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.RightArrow) {
                    root.step-viz(1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.step-viz(-1);
                    return accept;
                }
                if (event.text == Key.Escape || event.text == Key.Back || event.text == "v" || event.text == "V") {
                    root.viz-fullscreen = false;
                    keys.focus();
                    return accept;
                }
                if (event.text == " ") {
                    root.toggle-play();
                    return accept;
                }
                return reject;
            }
            // Buttons, hints and the mouse pointer show while the mouse moves
            // and fade out when it stops. Android: tap plays/stops, double
            // tap likes (on the desktop, clicks on the visualizer do nothing).
            full-idle := IdleArea {
                hide-cursor: true;
                clicked => {
                    if (!Theme.mobile) { return; }
                    if (tap-timer.running) {
                        tap-timer.running = false;
                        if (root.np-can-like) {
                            full-viz.heart-liked = !root.np-liked;
                            root.toggle-like();
                            full-viz.heart-show = true;
                            heart-timer.running = false;
                            heart-timer.running = true;
                        }
                    } else {
                        tap-timer.running = true;
                    }
                }
                keep-x: full-controls.x;
                keep-y: full-controls.y;
                keep-width: full-controls.width;
                keep-height: full-controls.height;
            }
        }

        // Track info and hints.
        VerticalLayout {
            x: parent.width * 0.06;
            y: parent.height * 0.84;
            width: parent.width * 0.88;
            spacing: 4px;
            Text {
                text: root.has-track ? root.np-title : "Nothing playing";
                color: Theme.fg;
                font-size: 26px;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: root.np-subtitle;
                color: Theme.fg-muted;
                font-size: 15px;
                overflow: elide;
            }
            Text {
                text: Theme.mobile ? "Tap for the buttons" : "← →: change style   ·   Esc: exit   ·   Space: play/pause";
                color: Theme.fg-muted;
                font-size: 12px;
                opacity: full-idle.active ? 1.0 : 0.0;
                animate opacity { duration: 250ms; }
            }
        }

        // The like / unlike heart, for a second after a double tap.
        Image {
            width: 120px;
            height: 120px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: full-viz.heart-liked ? @image-url("icons/heart-filled.svg") : @image-url("icons/heart.svg");
            colorize: Theme.dark ? #ffffff : Theme.accent;
            opacity: full-viz.heart-show ? 0.95 : 0.0;
            animate opacity { duration: 180ms; }
        }

        full-controls := VizControls {
            x: parent.width - self.width - 20px;
            y: 20px + root.titlebar-inset + root.safe-area-insets.top;
            style: root.viz-style;
            fullscreen: true;
            opacity: full-idle.active ? 1.0 : 0.0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 250ms; }
            step(d) => { root.step-viz(d); }
            toggle-fullscreen => {
                root.viz-fullscreen = false;
                keys.focus();
            }
        }
    }

    // Drop target shown while files are dragged over the window.
    if root.drop-hover: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.dark ? #0f0f13d0 : #f6f6f9d8;
        Rectangle {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: parent.height - 48px;
            border-radius: 20px;
            border-width: 3px;
            border-color: Theme.accent;
            background: Theme.accent-soft;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "Drop to play";
                    color: Theme.fg;
                    font-size: 28px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Music files play right away · folders are added to your library · M3U files become playlists";
                    color: Theme.fg-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Transient message (errors, "Added folder", …)
    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - (root.phone ? 140px + root.safe-area-insets.bottom : 88px) - self.height - 16px;
        width: Math.min(Math.min(560px, parent.width - 24px), toast-text.preferred-width + 40px);
        height: 40px;
        border-radius: 20px;
        background: Theme.dark ? #2d2d38 : #1f1f26;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        toast-text := Text {
            x: 20px;
            width: parent.width - 40px;
            height: parent.height;
            text: root.toast;
            color: #ffffff;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // Search suggestions (desktop): artists, albums and songs matching what
    // is typed. Clicking outside closes them.
    if root.search-dropdown && !root.phone && root.page != 3 && root.page != 10 && root.search-hits.length > 0: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        TouchArea {
            clicked => { root.search-dropdown = false; }
        }
        Rectangle {
            width: 380px;
            x: Math.max(8px, search.absolute-position.x + search.width - self.width);
            y: search.absolute-position.y + search.height + 6px;
            height: Math.min(hits-list.preferred-height, root.height - self.y - 16px);
            border-radius: 12px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000060;
            clip: true;
            // Swallow clicks between the rows.
            TouchArea { }
            hits-list := VerticalLayout {
                padding: 6px;
                spacing: 0px;
                for hit in root.search-hits: Rectangle {
                    height: hit.kind == -1 ? 28px : hit.kind == 3 ? 38px : 46px;
                    border-radius: 8px;
                    background: hit.kind >= 0 && hit-touch.has-hover ? Theme.surface-hover : transparent;
                    if hit.kind == -1: Text {
                        x: 10px;
                        y: 10px;
                        text: hit.title;
                        color: Theme.fg-muted;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 0.6px;
                    }
                    if hit.kind == 3: Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: hit.title;
                        color: Theme.accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if hit.kind >= 0 && hit.kind <= 2: HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            y: (parent.height - self.height) / 2;
                            border-radius: hit.kind == 0 ? 16px : 6px;
                            background: Theme.surface-hover;
                            Image {
                                width: 16px;
                                height: 16px;
                                source: hit.kind == 0 ? @image-url("icons/artist.svg") : hit.kind == 1 ? @image-url("icons/album.svg") : @image-url("icons/song.svg");
                                colorize: Theme.fg-muted;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: hit.title;
                                color: Theme.fg;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if hit.subtitle != "": Text {
                                text: hit.subtitle;
                                color: Theme.fg-muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                    hit-touch := TouchArea {
                        enabled: hit.kind >= 0;
                        mouse-cursor: hit.kind >= 0 ? pointer : default;
                        clicked => {
                            root.search-dropdown = false;
                            root.search-pick(hit.kind, hit.index);
                            if (hit.kind == 3) {
                                root.page = 2;
                            } else {
                                search.text = "";
                                if (hit.kind == 0) { root.page = 0; }
                                if (hit.kind == 1) { root.page = 5; }
                            }
                        }
                    }
                }
            }
        }
    }

    // Startup animation: covers the whole window, then fades into the app.
    if root.intro-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #0C091E;
        clip: true;
        opacity: root.intro-fading ? 0 : 1;
        animate opacity { duration: 450ms; easing: ease-in-out; }
        // The frames are 16:9 with the logo and "Unitn Music" spanning
        // about 1270 of the 1920 px (1400 keeps it whole, 1600 in portrait
        // also leaves a margin). Fill the window like `cover`, but never
        // so large that the wordmark is cut off: on a portrait phone the
        // frame is sized to the width and the background fills above/below.
        // Any window wider than about 1.3:1 (every desktop) looks as before.
        intro-image := Image {
            width: min(max(parent.width, parent.height * 16 / 9), parent.width * 1920 / (parent.width < parent.height ? 1600 : 1400));
            height: min(parent.height, self.width * 9 / 16);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.intro-frame;
            image-fit: cover;
        }
        // When the frame is shorter than the window, blend its top and
        // bottom edges into the background instead of showing a band.
        if intro-image.height < root.height: Rectangle {
            x: intro-image.x;
            y: intro-image.y;
            width: intro-image.width;
            height: intro-image.height * 0.25;
            background: @linear-gradient(180deg, #0C091E 0%, #0C091E00 100%);
        }
        if intro-image.height < root.height: Rectangle {
            x: intro-image.x;
            y: intro-image.y + intro-image.height * 0.75;
            width: intro-image.width;
            height: intro-image.height * 0.25;
            background: @linear-gradient(0deg, #0C091E 0%, #0C091E00 100%);
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.intro-skip(); }
        }
    }
}
